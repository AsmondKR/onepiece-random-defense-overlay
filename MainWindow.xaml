<Window x:Class="OrandOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원피스 유닛 추천 도우미" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        FontFamily="Malgun Gothic"
        Background="#FF080A0E" Foreground="White" WindowStartupLocation="CenterScreen">
  <DockPanel>
  <Border DockPanel.Dock="Left" Width="3" Background="#FFF0C75E"/>
  <Grid Margin="22">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="원랜디 코치" Foreground="#FF8B93A7" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="실시간 상위 유닛 추천" FontSize="22" FontWeight="Bold"
                 Foreground="#FFF0C75E" Margin="0,0,10,16" TextWrapping="Wrap"/>

      <Border Background="#FF0C0E14" BorderBrush="#FF242934" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="이번 판 설정" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock x:Name="GoalSelectLabel" Text="목표 상위 유닛 · 학습된 유닛만" Style="{StaticResource FieldLabel}"/>
          <Grid x:Name="GoalSelectRow" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="GoalCategoryCombo" DisplayMemberPath="Name" MinWidth="110"
                      SelectionChanged="GoalCategoryCombo_OnSelectionChanged" Margin="0,0,3,0"/>
            <ComboBox Grid.Column="1" x:Name="GoalCombo" DisplayMemberPath="Name"
                      SelectionChanged="GoalCombo_OnSelectionChanged" Margin="3,0,0,0"/>
          </Grid>
          <CheckBox x:Name="AutoStartCheck" Content="유닛 자동 추천" Margin="3,8,0,0"
                    Checked="AutoStart_OnChanged" Unchecked="AutoStart_OnChanged"
                    ToolTip="상위를 정하지 않고 시작해도, 첫 희귀함이 잡히면 그 희귀함이 들어가는 학습된 상위 중 표본이 가장 많은 것으로 목표를 자동 전환합니다. 판이 끝나면 다시 대기합니다."/>
          <TextBlock x:Name="BuildVariantLabel" Text="빌드 방향" Style="{StaticResource FieldLabel}"
                     Margin="0,12,0,0" Visibility="Collapsed"/>
          <ComboBox x:Name="BuildVariantCombo" DisplayMemberPath="Name"
                    SelectionChanged="BuildVariantCombo_OnSelectionChanged" Margin="0,6,0,0"
                    Visibility="Collapsed"/>
          <TextBlock x:Name="BuildVariantSummaryText" Style="{StaticResource FieldHint}"
                     Margin="3,5,3,0" Visibility="Collapsed"/>
          <TextBlock Text="항법" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="NavigationCategoryCombo" DisplayMemberPath="Name"
                      SelectionChanged="NavigationCategoryCombo_OnSelectionChanged" Margin="0,0,3,0"/>
            <ComboBox Grid.Column="1" x:Name="NavigationCombo" DisplayMemberPath="Name"
                      SelectionChanged="NavigationCombo_OnSelectionChanged" Margin="3,0,0,0"/>
          </Grid>
          <TextBlock x:Name="NavigationSummaryText" Style="{StaticResource FieldHint}" Margin="3,5,3,0"/>
          <TextBlock Text="오로성 (신 이상 판별 효과)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
          <ComboBox x:Name="GoroseiCombo" DisplayMemberPath="Name"
                    SelectionChanged="GoroseiCombo_OnSelectionChanged" Margin="0,6,0,0"/>
          <TextBlock x:Name="GoroseiSummaryText" Style="{StaticResource FieldHint}" Margin="3,5,3,0"/>
        </StackPanel>
      </Border>

      <Border Background="#FF0C0E14" BorderBrush="#FF242934" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="현재 보유 패" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" x:Name="RecognitionStatus" Text="수동 모드" Foreground="#FF4ADE80" FontSize="11"/>
          </Grid>
          <ListBox x:Name="InventoryList" Height="180" Margin="0,10,0,8" Background="#FF10131B"
                   BorderThickness="0" Foreground="White" FontSize="13"/>
        </StackPanel>
      </Border>

      <Border Background="#FF0C0E14" BorderBrush="#FF242934" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="설정" FontSize="14" FontWeight="SemiBold"/>
          <CheckBox x:Name="AutoScanCheck" Content="실시간 메모리 인식" Margin="3,10,0,5" IsChecked="True" Checked="AutoScan_OnChanged" Unchecked="AutoScan_OnChanged"/>
          <CheckBox x:Name="ClickThroughCheck" Content="오버레이 클릭 통과" Margin="3,5" IsChecked="False" Checked="ClickThrough_OnChanged" Unchecked="ClickThrough_OnChanged"/>
          <CheckBox x:Name="ClearDataRefreshCheck" Content="신+ 클리어 데이터 자동 갱신" Margin="3,5" IsChecked="True" Checked="ClearDataRefresh_OnChanged" Unchecked="ClearDataRefresh_OnChanged"/>
          <Button Content="오버레이 이동" Click="EnableOverlayMove_OnClick" HorizontalAlignment="Left" Margin="0,4,0,0"
                  ToolTip="누른 뒤 오버레이 상단을 끌어 옮깁니다"/>
          <TextBlock Text="오버레이 켜기/끄기 키" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     PreviewKeyDown="Hotkey_OnPreviewKeyDown" LostFocus="Hotkey_OnLostFocus"
                     ToolTip="게임 중에도 동작하는 전역 단축키"/>
            <Button Grid.Column="1" x:Name="HotkeyCaptureButton" Content="키 변경" Margin="8,0,0,0"
                    Click="HotkeyCapture_OnClick"/>
          </Grid>
          <TextBlock x:Name="HotkeyHint" Style="{StaticResource FieldHint}" Margin="3,5,3,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="추천 보드" FontSize="11" FontWeight="SemiBold" Foreground="#FF8B93A7"/>
          <TextBlock Text="지금 만들 유닛" FontSize="20" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="DataVersionText" Foreground="#FF7F8796" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="정산" Click="Settlement_OnClick"
                  ToolTip="클리어 직후 결과 화면에서 누르세요. 인식된 유닛(필드 배치 포함)을 티어별로 세어 몇 전설을 짰는지 보여줍니다."/>
          <Button Content="다시 추천" Click="ReRecommend_OnClick" Background="#FF1C2028"
                  ToolTip="지금 패 기준으로 조합이 가장 가까운(완성률 최고) 학습 상위를 다시 계산해 추천합니다."/>
          <Button x:Name="OverlayButton" Content="오버레이 숨기기" Click="ToggleOverlay_OnClick"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="220"/>
        </Grid.RowDefinitions>
        <Border Background="#FF12151C" CornerRadius="12" Padding="12,10">
          <StackPanel x:Name="NowPanel"/>
        </Border>
        <Border Grid.Row="1" Background="#FF0C0E14" CornerRadius="12" Padding="10,8" Margin="0,10,0,0">
          <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FlowPanel"/>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="#FF0C0E14" CornerRadius="12" Padding="10,8" Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="후보 보드  ·  눌러서 흐름 전환" Foreground="#FF8B93A7" FontSize="11"
                         FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel x:Name="BoardPanel"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="3" Background="#FF0C0E14" BorderBrush="#FF242934" BorderThickness="1"
              CornerRadius="12" Padding="10" Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FooterStatus" Text="준비됨" Foreground="#FFB3BAC8" FontSize="12" TextWrapping="Wrap"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
            <Button Content="업데이트 확인" Click="CheckUpdateNow_OnClick" Style="{StaticResource SubtleButton}"
                    FontSize="10.5" Padding="8,2" Margin="0,0,8,0"
                    ToolTip="새 릴리스가 있으면 바로 내려받아 자동으로 재시작합니다."/>
            <TextBlock x:Name="VersionText" Foreground="#FF7F8796" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </DockPanel>
</Window>
