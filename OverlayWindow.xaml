<local:OverlayWindowBase x:Class="OrandOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Width="760" Height="680" Top="48" Left="1140"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <Border CornerRadius="16" Background="#F2080A0E" BorderBrush="#FF2A3140" BorderThickness="1">
    <Grid Margin="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="280"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown"
            Margin="12,10,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="GoalText" Text="야마토 초월" Foreground="#FFF0C75E"
                     FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="PhaseHintText" Foreground="#FFB4BBC6" FontSize="11"
                     TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="정산" Click="SettlementButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="클리어 직후 인식된 유닛을 티어별로 세어 몇 전설을 짰는지 보여줍니다."/>
          <Button Content="다시 추천" Click="ReRecommendButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="지금 패 기준으로 조합이 가장 가까운 학습 상위를 다시 계산해 추천합니다."/>
          <Border x:Name="ClickThroughBadge" Visibility="Collapsed"
                  Background="#331C2028" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="클릭 통과" Foreground="#FF8B93A7" FontSize="10"/>
          </Border>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#FF12151C" CornerRadius="12" Margin="12,10,12,0" Padding="12,10">
        <StackPanel x:Name="NowPanel"/>
      </Border>
      <Border Grid.Row="2" Background="#FF0C0E14" CornerRadius="12" Margin="12,8,12,0" Padding="10,8">
        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FlowPanel"/>
        </ScrollViewer>
      </Border>
      <Border Grid.Row="3" Background="#FF0C0E14" CornerRadius="12" Margin="12,8,12,0" Padding="10,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="후보 보드  ·  눌러서 흐름 전환" Foreground="#FF8B93A7" FontSize="10"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel x:Name="BoardPanel"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="4" Margin="14,8,14,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Foreground="#FF8B93A7" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" x:Name="OverlayVersionText" Foreground="#FF6B7384" FontSize="10.5"
                   VerticalAlignment="Bottom" Margin="10,0,0,0"/>
      </Grid>
    </Grid>
  </Border>
</local:OverlayWindowBase>
