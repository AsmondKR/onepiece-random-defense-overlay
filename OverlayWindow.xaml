<local:OverlayWindowBase x:Class="OrandOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Width="520" Height="700" Top="48" Left="1460"
        FontFamily="Malgun Gothic"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <!-- 테스트2: 카드 더미가 아니라 피처드+표 HUD. -->
  <Border Background="#F2080A0E" BorderBrush="#FF232833" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="3" Background="#FFF0C75E"/>
      <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="추천" Foreground="#FF8B93A7" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="GoalText" Text="야마토 초월" Foreground="#FFF0C75E"
                       FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PhaseHintText" Foreground="#FFB4BBC6" FontSize="11"
                       TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="정산" Click="SettlementButton_OnClick"
                    Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                    ToolTip="클리어 직후 인식된 유닛을 티어별로 세어 몇 전설을 짰는지 보여줍니다."/>
            <Button Content="다시 추천" Click="ReRecommendButton_OnClick"
                    Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                    ToolTip="지금 패 기준으로 조합이 가장 가까운 학습 상위를 다시 계산해 추천합니다."/>
            <Border x:Name="ClickThroughBadge" Visibility="Collapsed"
                    Background="#331C2028" CornerRadius="2" Padding="7,2" VerticalAlignment="Center">
              <TextBlock Text="클릭 통과" Foreground="#FF8B93A7" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="RecommendationScroll"
                      VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
          <StackPanel x:Name="RecommendationPanel"/>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Foreground="#FF8B93A7" FontSize="11"/>
          <TextBlock Grid.Column="1" x:Name="OverlayVersionText" Foreground="#FF6B7384" FontSize="10.5"
                     VerticalAlignment="Bottom" Margin="10,0,0,0"/>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</local:OverlayWindowBase>
