<local:OverlayWindowBase x:Class="OrandOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Width="520" Height="700" Top="48" Left="1460"
        FontFamily="Malgun Gothic"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <!-- 게임 화면 위 가독성: 배경 투과를 줄이고 본문 대비를 확보한다. -->
  <Border Background="#F2111318" BorderBrush="#FF2C313A" BorderThickness="1"
          CornerRadius="6" Padding="10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid  Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="GoalText" Text="야마토 초월" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="PhaseHintText" Foreground="#FFFBBF24" FontSize="11.5"
                     TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="정산" Click="SettlementButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="클리어 직후 인식된 유닛을 티어별로 세어 몇 전설을 짰는지 보여줍니다."/>
          <Button Content="다시 추천" Click="ReRecommendButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="지금 패 기준으로 조합이 가장 가까운 학습 상위를 다시 계산해 추천합니다."/>
          <Border x:Name="ClickThroughBadge" Visibility="Collapsed"
                  Background="#33334155" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="클릭 통과" Foreground="#FF9CA3AF" FontSize="10"/>
          </Border>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" x:Name="RecommendationScroll"
                    VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel x:Name="RecommendationPanel"/>
      </ScrollViewer>
      <Grid Grid.Row="2"  Margin="2,10,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Foreground="#FFB3BAC8" FontSize="12"/>
        <TextBlock Grid.Column="1" x:Name="OverlayVersionText" Foreground="#FF7F8796" FontSize="10.5"
                   VerticalAlignment="Bottom" Margin="10,0,0,0"/>
      </Grid>
    </Grid>
  </Border>
</local:OverlayWindowBase>
