<local:OverlayWindowBase x:Class="OrandOverlay.StatsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Width="300" Height="700" Top="48" Left="1140"
        FontFamily="Malgun Gothic"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <!-- 테스트2: 상단 KPI 3칸 + 조합 큐 + 2열 수치. -->
  <Border Background="#F2080A0E" BorderBrush="#FF232833" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="3" Background="#FFF0C75E"/>
      <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="내 패" Foreground="#FF8B93A7" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="상태 보드" Foreground="#FFF0C75E" FontSize="16" FontWeight="Bold"/>
          </StackPanel>
          <Border Grid.Column="1" x:Name="ClickThroughBadge" Visibility="Collapsed"
                  Background="#331C2028" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="클릭 통과" Foreground="#FF8B93A7" FontSize="10"/>
          </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="CombineHeader" Text="지금 조합" Foreground="#FFF0C75E"
                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="Collapsed"/>
            <StackPanel x:Name="CombinePanel" Visibility="Collapsed" Margin="0,0,0,10"/>
            <TextBlock x:Name="EmergencyHeader" Text="긴급소집" Foreground="#FFF0C75E"
                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="Collapsed"/>
            <StackPanel x:Name="EmergencyPanel" Visibility="Collapsed" Margin="0,0,0,8"/>
            <Border BorderBrush="#FF242934" BorderThickness="0,0,0,1" Margin="0,0,0,8">
              <UniformGrid x:Name="CoreKpiPanel" Columns="3"/>
            </Border>
            <StackPanel x:Name="CurrentStatsPanel"/>
            <TextBlock Text="희귀패 정리" Foreground="#FF8B93A7" FontSize="10"
                       FontWeight="SemiBold" Margin="0,10,0,6"/>
            <StackPanel x:Name="RareRerollPanel"/>
            <TextBlock x:Name="SpecialHeader" Text="특수함 정리" Foreground="#FF8B93A7" FontSize="10"
                       FontWeight="SemiBold" Margin="0,10,0,6" Visibility="Collapsed"/>
            <StackPanel x:Name="SpecialPanel" Visibility="Collapsed"/>
            <TextBlock x:Name="GreenBloodHeader" Text="그린블러드" Foreground="#FF3DDC84" FontSize="10"
                       FontWeight="SemiBold" Margin="0,10,0,6" Visibility="Collapsed"/>
            <StackPanel x:Name="GreenBloodPanel" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</local:OverlayWindowBase>
